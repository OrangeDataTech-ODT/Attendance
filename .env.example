# Django
DJANGO_SECRET_KEY=your-secret-key-here

# Database (PostgreSQL connection string)
DATABASE_URL=postgres://user:password@localhost:5432/attendance

# API authentication
API_KEY_VALUE=your-api-key

# Vercel Blob storage
BLOB_READ_WRITE_TOKEN=your-blob-token

# Deployed server URL used by the internal scheduler to call cron endpoints
RENDER_EXTERNAL_URL=http://172.83.83.163:8000

# Set to False to disable APScheduler
USE_INTERNAL_SCHEDULER=True

# Scheduled task authentication (optional)
CRON_SECRET_TOKEN=your-cron-token
